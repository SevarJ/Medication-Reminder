    "banner.message.request": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on notifications so your reminders arrive on time."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xatırlatmaların vaxtında gəlməsi üçün bildirişləri aktiv edin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите уведомления, чтобы напоминания приходили вовремя."
          }
        }
      }
    },
    "banner.message.settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders cannot be delivered until notifications are enabled in Settings."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlər Ayarlarda aktiv edilənə qədər xatırlatmalar gəlməyəcək."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания не будут приходить, пока уведомления не включены в Настройках."
          }
        }
      }
    },
