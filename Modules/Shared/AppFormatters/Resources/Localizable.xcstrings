          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте хотя бы одно время напоминания."
          }
        }
      }
    },
    "error.weekdayUnselected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select at least one day of the week."
          }
