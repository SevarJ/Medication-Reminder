    "error.doseOutsideEditableRange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doses can only be updated within the last 7 days."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozaları yalnız son 7 gün ərzində dəyişmək olar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменять приёмы можно только за последние 7 дней."
          }
        }
      }
    },
    "error.duplicateTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder times must be different from each other."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xatırlatma vaxtları bir-birindən fərqli olmalıdır."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время напоминаний не должно повторяться."
          }
        }
      }
    },
    "error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xəta baş verdi. Yenidən cəhd edin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так. Попробуйте ещё раз."
          }
        }
      }
    },
    "error.invalidDateRange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end date cannot be earlier than the start date."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitmə tarixi başlama tarixindən əvvəl ola bilməz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата окончания не может быть раньше даты начала."
          }
        }
      }
    },
    "error.invalidTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a valid reminder time."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzgün xatırlatma vaxtı seçin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите корректное время напоминания."
          }
        }
      }
    },
    "error.medicationNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This medication no longer exists."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dərman artıq mövcud deyil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это лекарство больше не существует."
          }
        }
      }
    },
    "error.nameEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a medication name."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dərmanın adını daxil edin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите название лекарства."
          }
        }
      }
    },
    "error.notSignedIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're signed out. Please sign in again."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabdan çıxmısınız. Yenidən daxil olun."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы вышли из аккаунта. Войдите снова."
          }
        }
      }
    },
    "error.notificationsOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are turned off, so reminders were not scheduled."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirişlər söndürülüb, ona görə xatırlatmalar qurulmadı."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления выключены, поэтому напоминания не запланированы."
          }
        }
      }
    },
    "error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Connect and try again."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet bağlantısı yoxdur. Qoşulub yenidən cəhd edin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к интернету. Подключитесь и попробуйте ещё раз."
          }
        }
      }
    },
    "error.signInFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't sign in with Google. Please try again."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Google ilə daxil olmaq alınmadı. Yenidən cəhd edin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти через Google. Попробуйте ещё раз."
          }
        }
      }
    },
    "error.timeUnselected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add at least one reminder time."
          }
