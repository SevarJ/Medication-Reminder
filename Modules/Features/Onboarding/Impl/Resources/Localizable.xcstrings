    "introduction.reminders.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You get a notification when it's time for a dose."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Doza vaxtı çatanda bildiriş alırsınız."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда придёт время приёма, вы получите уведомление."
          }
        }
      }
    },
    "introduction.reminders.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-Time Reminders"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtında xatırlatma"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания вовремя"
          }
        }
      }
    },
    "introduction.stock.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll tell you 3 days before a box runs out."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qutu bitməzdən 3 gün əvvəl xəbər veririk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупредим за 3 дня до конца упаковки."
          }
        }
      }
    },
    "introduction.stock.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never Run Out"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dərmanınız bitməsin"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лекарство не закончится"
          }
        }
      }
    },
    "introduction.today.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what you've taken today and what's left."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün nəyi qəbul etdiyinizi və nəyin qaldığını görün."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите, что уже принято сегодня и что осталось."
          }
        }
      }
    },
    "introduction.today.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Day at a Glance"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gününüz bir baxışda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш день на одном экране"
          }
        }
      }
    },
