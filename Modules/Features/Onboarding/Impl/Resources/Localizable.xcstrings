        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaxtı çatanda xəbər verəcəyik."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы напомним, когда придёт время."
          }
        }
      }
    },
