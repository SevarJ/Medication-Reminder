    "banner.message.request": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on notifications so your reminders arrive on time."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Xatırlatmaların vaxtında gəlməsi üçün bildirişləri aktiv edin."
