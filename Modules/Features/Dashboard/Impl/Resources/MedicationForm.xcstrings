        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nə qədəriniz var?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько у вас есть?"
          }
        }
      }
    },
    "form.stock.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Each dose you take is subtracted, and you'll see when you're running low."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstəyə bağlı. Qəbul etdiyiniz hər doza çıxılır və qalıq azalanda görürsünüz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно. Каждая принятая доза вычитается, и вы увидите, когда запас на исходе."
          }
        }
      }
    },
    "form.notes.title": {
      "extractionState": "manual",
